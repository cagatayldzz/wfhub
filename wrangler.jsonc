{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "wfhub",
  "main": "apps/wfhub-api/worker/dist/index.js",
  "compatibility_date": "2026-10-29",
  "workers_dev": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "cy-team.cloudflareaccess.com",
    "ACCESS_AUD": "cb1419d17532ebf689c2920aeef182c53a21ab3c3c92d1d9c2a6e55da55d9ef1"
  },
  "preview_urls": false,
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wfhub",
      "database_id": "8340891c-14c6-40cd-918d-87802e131d5b",
      "migrations_dir": "apps/wfhub-api/migrations"
    }
  ]
}
