{
  "openapi": "3.0.3",
  "info": {
    "title": "WFHub API",
    "description": "Browse the Codex catalogue, mastery checklists, and event banners used by WFHub.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://wfhub.cagatayldzz.com"
    }
  ],
  "paths": {
    "/api/{category}.json": {
      "get": {
        "summary": "List Codex items",
        "operationId": "listCategoryItems",
        "parameters": [
          {
            "$ref": "#/components/parameters/Category"
          }
        ],
        "responses": {
          "200": {
            "description": "Category item list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ApiItem"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Category not found"
          }
        },
        "tags": [
          "Codex"
        ],
        "description": "Returns the items available in a Codex category. Use the returned slug to request an item’s details."
      }
    },
    "/api/{category}/{slug}.json": {
      "get": {
        "summary": "Get Codex item details",
        "operationId": "getCategoryItem",
        "parameters": [
          {
            "$ref": "#/components/parameters/Category"
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "description": "The item's URL slug, for example `akimbo-slip-shot`.",
            "schema": {
              "type": "string",
              "example": "akimbo-slip-shot"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Single category item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiDetailItem"
                }
              }
            }
          },
          "404": {
            "description": "Item not found"
          }
        },
        "tags": [
          "Codex"
        ],
        "description": "Returns the details of one item using its category and slug."
      }
    },
    "/api/mastery/{category}.json": {
      "get": {
        "summary": "List checklist entries",
        "operationId": "listMasteryItems",
        "responses": {
          "200": {
            "description": "Checklist entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MasteryWarframe"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Unknown category"
          }
        },
        "parameters": [
          {
            "name": "category",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "warframes",
                "primary",
                "secondary",
                "melee",
                "kitgun",
                "zaw",
                "amp",
                "sentinel",
                "moa",
                "hound",
                "beast",
                "robotic",
                "archwing",
                "archgun",
                "archmelee",
                "necramech",
                "railjack",
                "k-drive",
                "railjack-intrinsic",
                "drifter-intrinsic",
                "starchart",
                "steel-path",
                "founders",
                "china-founders"
              ]
            },
            "description": "Checklist category, such as warframes, primary, starchart, or railjack-intrinsic."
          }
        ],
        "tags": [
          "Mastery Checklist"
        ],
        "description": "Returns the entries, maximum levels, and mastery points for one checklist category. The image can be null when the wiki table has no image."
      }
    },
    "/api/mastery/updated.json": {
      "get": {
        "summary": "Get checklist update dates",
        "responses": {
          "200": {
            "description": "Snapshot and wiki update dates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "updatedAt",
                    "wikiUpdatedAt"
                  ],
                  "properties": {
                    "updatedAt": {
                      "type": "string",
                      "format": "date",
                      "example": "2026-11-07"
                    },
                    "wikiUpdatedAt": {
                      "type": "string",
                      "format": "date-time",
                      "example": "2026-10-23T03:20:57Z"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Mastery Checklist"
        ],
        "operationId": "getMasteryUpdateDates",
        "description": "Returns the date WFHub last updated the snapshot and the source wiki page’s update timestamp."
      }
    },
    "/api/events.json": {
      "get": {
        "tags": [
          "Events"
        ],
        "summary": "List event banners",
        "operationId": "listEvents",
        "description": "Returns the event banners and links shown on the home screen.",
        "responses": {
          "200": {
            "description": "Event banners",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "title",
                      "imageLink",
                      "link"
                    ],
                    "properties": {
                      "title": {
                        "type": "string",
                        "example": "Tau 2026"
                      },
                      "imageLink": {
                        "type": "string",
                        "format": "uri"
                      },
                      "link": {
                        "type": "string",
                        "description": "Destination URL; {lang} is replaced by the selected language."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Category": {
        "name": "category",
        "in": "path",
        "required": true,
        "description": "One of the generated data categories.",
        "schema": {
          "type": "string",
          "enum": [
            "arcanes",
            "arch-gun",
            "arch-melee",
            "archwing",
            "enemy",
            "fish",
            "gear",
            "glyphs",
            "melee",
            "misc",
            "mods",
            "node",
            "pets",
            "primary",
            "quests",
            "railjack",
            "relics",
            "resources",
            "secondary",
            "sentinels",
            "sentinelweapons",
            "sigils",
            "skins",
            "warframes"
          ]
        }
      }
    },
    "schemas": {
      "ApiItem": {
        "type": "object",
        "required": [
          "name",
          "imageName",
          "slug"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash Prime"
          },
          "imageName": {
            "type": "string",
            "format": "uri",
            "example": "https://raw.githubusercontent.com/WFCD/warframe-items/master/data/img/AshPrime.png"
          },
          "slug": {
            "type": "string",
            "example": "ash-prime"
          }
        },
        "additionalProperties": false
      },
      "ApiDetailItem": {
        "type": "object",
        "required": [
          "uniqueName",
          "name",
          "description",
          "health",
          "shield",
          "armor",
          "stamina",
          "power",
          "masteryReq",
          "sprintSpeed",
          "abilities",
          "sprint",
          "wikiaUrl",
          "releaseDate",
          "imageName",
          "slug"
        ],
        "properties": {
          "uniqueName": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "example": "Ash"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "health": {
            "type": [
              "number",
              "null"
            ]
          },
          "shield": {
            "type": [
              "number",
              "null"
            ]
          },
          "armor": {
            "type": [
              "number",
              "null"
            ]
          },
          "stamina": {
            "type": [
              "number",
              "null"
            ]
          },
          "power": {
            "type": [
              "number",
              "null"
            ]
          },
          "masteryReq": {
            "type": [
              "number",
              "null"
            ]
          },
          "sprintSpeed": {
            "type": [
              "number",
              "null"
            ]
          },
          "abilities": {
            "type": "array",
            "items": {}
          },
          "sprint": {
            "type": [
              "number",
              "null"
            ]
          },
          "wikiaUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "releaseDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "imageName": {
            "type": "string",
            "format": "uri",
            "example": "https://raw.githubusercontent.com/WFCD/warframe-items/master/data/img/Ash.png"
          },
          "slug": {
            "type": "string",
            "example": "ash"
          }
        },
        "additionalProperties": false
      },
      "MasteryWarframe": {
        "type": "object",
        "required": [
          "name",
          "image",
          "level",
          "mastery"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash"
          },
          "image": {
            "type": "string",
            "format": "uri",
            "nullable": true
          },
          "level": {
            "type": "integer",
            "example": 30,
            "nullable": true
          },
          "mastery": {
            "type": "integer",
            "example": 6000
          },
          "id": {
            "type": "string"
          },
          "group": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "Codex",
      "description": "Browse item categories and their details. Data comes from WFCD warframe-items."
    },
    {
      "name": "Mastery Checklist",
      "description": "Explore the checklist snapshot and its update dates. Completion progress is stored separately on your device."
    },
    {
      "name": "Events",
      "description": "Banners and links maintained for the WFHub home screen."
    }
  ]
}
