{
  "name": "wfhub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf:deploy": "bash scripts/build-site.sh && npx wrangler d1 migrations apply DB --remote && npx wrangler deploy",
    "cf:build": "bash scripts/build-site.sh",
    "cf:preview": "bash scripts/build-site.sh && npx wrangler versions upload",
    "commit": "bash scripts/commit.sh",
    "format:rust": "cargo fmt --manifest-path apps/wfhub-api/Cargo.toml",
    "format:swift": "swift format --in-place --recursive apps/wfhub-mobile/WFHub",
    "dev:web": "bash scripts/build-site.sh && npx wrangler dev --local --port 8000",
    "api:test": "cargo test --release --manifest-path apps/wfhub-api/Cargo.toml",
    "api:build": "bash scripts/build-worker.sh",
    "catalogue:fetch": "bash apps/wfhub-api/catalogue/fetch.sh",
    "catalogue:export": "cargo run --release --manifest-path apps/wfhub-api/Cargo.toml --bin export-catalogue -- apps/wfhub-api/catalogue/sources apps/wfhub-api/data/catalogue",
    "mobile:archive": "bash scripts/mobile.sh archive",
    "mobile:project": "bash scripts/mobile.sh project",
    "mobile:simulator": "bash scripts/mobile.sh simulator",
    "test": "cargo test --release --manifest-path apps/wfhub-api/Cargo.toml"
  }
}
